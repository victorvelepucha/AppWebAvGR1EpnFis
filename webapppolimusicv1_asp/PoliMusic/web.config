<?xml version="1.0" encoding="UTF-8"?>
<!--
  ===========================================================================
   PoliMusic - Configuracion de IIS para la aplicacion ASP clasico
   Se aplica automaticamente al copiar el sitio dentro de C:\inetpub\wwwroot
  ===========================================================================
-->
<configuration>

  <appSettings>
    <add key="PoliMusic.Version" value="1.0.0" />
  </appSettings>

  <system.webServer>

    <!-- Documento predeterminado -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="default.asp" />
        <add value="index.asp" />
        <add value="iisstart.htm" />
      </files>
    </defaultDocument>

    <!-- Motor ASP clasico.
         scriptErrorSentToBrowser="false" evita exponer detalles internos.
         El script desplegar.ps1 -Debug lo activa temporalmente para depurar. -->
    <asp codePage="65001"
         scriptErrorSentToBrowser="false"
         enableParentPaths="false"
         enableSessionState="true"
         bufferingOn="true"
         allowSessionState="true"
         maxRequestEntityAllowed="2097152"
         queueConnectionTestTime="00:00:03">
      <session allowSessionState="true" timeout="01:00:00" />
      <limits maxRequestEntityAllowed="2097152" />
      <cache diskTemplateCacheDirectory="%SystemDrive%\inetpub\temp\ASP Compiled Templates" />
    </asp>

    <!-- Tipos MIME necesarios para los recursos multimedia -->
    <staticContent>
      <remove fileExtension=".mp3" />
      <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
      <remove fileExtension=".m4a" />
      <mimeMap fileExtension=".m4a" mimeType="audio/mp4" />
      <remove fileExtension=".ogg" />
      <mimeMap fileExtension=".ogg" mimeType="audio/ogg" />
      <remove fileExtension=".wav" />
      <mimeMap fileExtension=".wav" mimeType="audio/wav" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <!-- Compresion -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- Cabeceras de seguridad -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- Errores personalizados.
         El script de despliegue (desplegar.ps1) ajusta la ruta segun la
         ubicacion final del sitio, por eso aqui no se fija ninguna. -->
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />

    <!-- Bloquear el acceso directo a las carpetas internas -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="includes" />
        </hiddenSegments>
      </requestFiltering>
    </security>

  </system.webServer>

</configuration>
